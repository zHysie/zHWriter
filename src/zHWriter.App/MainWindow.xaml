<Window x:Class="zHWriter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="160" MinWidth="300" MinHeight="96"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="CanResize"
        Loaded="Window_Loaded" Closing="Window_Closing"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseUp="Window_PreviewMouseUp" PreviewMouseWheel="Window_PreviewMouseWheel"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCDCE6F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 背景用 #01000000 而非 Transparent：AllowsTransparency 使本窗口成为分层窗口，
         Windows 按像素 alpha 做命中测试，alpha=0 的区域会被鼠标穿透、无法点击/输入。
         alpha=1 肉眼不可见，但能正常接收鼠标与键盘输入。 -->

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="打开周期日历" Click="OpenCalendar_Click"/>
            <Separator/>
            <MenuItem Header="打开今日日记" Click="OpenToday_Click"/>
            <MenuItem Header="打开本周周记" Click="OpenThisWeek_Click"/>
            <MenuItem Header="打开本月月记" Click="OpenThisMonth_Click"/>
            <Separator/>
            <MenuItem Header="保存" Click="Save_Click"/>
            <Separator/>
            <MenuItem Header="打开笔记库文件夹" Click="OpenRootFolder_Click"/>
            <MenuItem Header="打开当前笔记所在文件夹" Click="OpenCurrentFolder_Click"/>
            <MenuItem Header="打开模板文件夹" Click="OpenTemplatesFolder_Click"/>
            <Separator/>
            <MenuItem Header="设置" Click="Settings_Click"/>
            <Separator/>
            <MenuItem Header="保存并退出" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="2">
        <Border x:Name="AltBorder" BorderBrush="#00000000" BorderThickness="0" CornerRadius="2">
            <Grid>
                <Border x:Name="CollapsedPanel" Background="#01000000" MouseLeftButtonUp="Collapsed_Click" Padding="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="zH" FontWeight="SemiBold" FontSize="15" Foreground="{Binding EditorForeground}"/>
                </Border>
                <Border x:Name="ExpandedPanel" Visibility="Collapsed" Background="#01000000">
                    <TextBox x:Name="Editor"
                             Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Hidden"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{Binding EditorForeground}" FontSize="15"
                             CaretBrush="{Binding EditorForeground}"
                             Opacity="{Binding Settings.TextOpacity}"
                             Padding="2" PreviewKeyDown="Editor_PreviewKeyDown"/>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom-right transient status overlay (no layout footprint, never takes focus). -->
        <TextBlock x:Name="OverlayText" Text="" Foreground="{Binding EditorForeground}" FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2"
                   Opacity="0" IsHitTestVisible="False"/>

        <!-- LifeOS-style periodic-note picker -->
        <Popup x:Name="CalendarPopup" IsOpen="{Binding IsCalendarOpen}" Placement="Bottom"
               PlacementTarget="{Binding ElementName=ExpandedPanel}" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#F71E2A38" CornerRadius="6" Padding="10" Width="330">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Period tabs (single click switches, double click opens today / this week / this month). -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                        <Button x:Name="TabDailyButton" Content="日记" Click="TabDaily_Click" MouseDoubleClick="TabDaily_DoubleClick" HorizontalAlignment="Center" FontSize="13" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#99FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalendarPeriod}" Value="Daily">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="TabWeeklyButton" Content="周记" Click="TabWeekly_Click" MouseDoubleClick="TabWeekly_DoubleClick" HorizontalAlignment="Center" FontSize="13" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#99FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalendarPeriod}" Value="Weekly">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="TabMonthlyButton" Content="月记" Click="TabMonthly_Click" MouseDoubleClick="TabMonthly_DoubleClick" HorizontalAlignment="Center" FontSize="13" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#99FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalendarPeriod}" Value="Monthly">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <!-- Year / month navigation -->
                    <DockPanel Grid.Row="1">
                        <Button Content="‹" Style="{StaticResource FlatButton}" Command="{Binding PreviousPeriodCommand}" Width="26" Padding="0"/>
                        <Button Content="›" Style="{StaticResource FlatButton}" DockPanel.Dock="Right" Command="{Binding NextPeriodCommand}" Width="26" Padding="0"/>
                        <TextBlock Text="{Binding CalendarTitle}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>

                    <!-- Weekday header (daily only) -->
                    <UniformGrid Grid.Row="2" Columns="7" Margin="0,6,0,2" Visibility="{Binding DayHeaderVisibility}">
                        <TextBlock Text="一" Foreground="#B0FFFFFF" TextAlignment="Center" FontSize="11"/>
                        <TextBlock Text="二" Foreground="#B0FFFFFF" TextAlignment="Center" FontSize="11"/>
                        <TextBlock Text="三" Foreground="#B0FFFFFF" TextAlignment="Center" FontSize="11"/>
                        <TextBlock Text="四" Foreground="#B0FFFFFF" TextAlignment="Center" FontSize="11"/>
                        <TextBlock Text="五" Foreground="#B0FFFFFF" TextAlignment="Center" FontSize="11"/>
                        <TextBlock Text="六" Foreground="#B0FFFFFF" TextAlignment="Center" FontSize="11"/>
                        <TextBlock Text="日" Foreground="#B0FFFFFF" TextAlignment="Center" FontSize="11"/>
                    </UniformGrid>

                    <!-- Daily grid -->
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding CalendarDays}" Visibility="{Binding DailyBodyVisibility}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenCalendarCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Background="{Binding Background}" Opacity="{Binding Opacity}"
                                        BorderThickness="0" Padding="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MainLabel}" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Marker}" Foreground="#FF7DD3FC" Height="8" FontSize="10" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Weekly list -->
                    <ScrollViewer Grid.Row="3" Visibility="{Binding WeeklyBodyVisibility}" MaxHeight="252"
                                  VerticalScrollBarVisibility="Hidden" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenCalendarCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Background="{Binding Background}" Opacity="{Binding Opacity}"
                                            BorderThickness="0" Padding="5,4" Margin="0,1" HorizontalContentAlignment="Stretch">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Marker}" Foreground="#FF7DD3FC" DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding MainLabel}" Foreground="White" FontSize="13"/>
                                                <TextBlock Text="{Binding SubLabel}" Foreground="#99FFFFFF" FontSize="10"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Monthly grid -->
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding CalendarDays}" Visibility="{Binding MonthlyBodyVisibility}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenCalendarCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Background="{Binding Background}" Opacity="{Binding Opacity}"
                                        BorderThickness="0" Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MainLabel}" Foreground="White" TextAlignment="Center" FontSize="13"/>
                                        <TextBlock Text="{Binding Marker}" Foreground="#FF7DD3FC" Height="8" FontSize="10" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="4" Content="今天" Style="{StaticResource FlatButton}" Command="{Binding TodayPeriodCommand}"
                            HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
